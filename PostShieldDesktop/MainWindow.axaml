<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PostShield.MainWindow"
        Title="PostShield"
        Width="900" Height="600">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
      <Button x:Name="BrowseBtn" Content="Choose Folder" Margin="4"/>
      <Button x:Name="ScanBtn" Content="Scan .xlsx" Margin="4"/>
      <Button x:Name="MaskBtn" Content="Apply Masking" Margin="4"/>
      <Button x:Name="UndoMaskBtn" Content="Undo Masking" Margin="4" IsEnabled="False"/>
      
      <Separator Width="20"/>
      
      <!-- Operation buttons -->
      <Button x:Name="OpenBtn" Content="Open File" Margin="4" IsEnabled="False"/>
      <Button x:Name="RenameBtn" Content="Rename" Margin="4" IsEnabled="False"/>
      <Button x:Name="DeleteBtn" Content="Delete" Margin="4" IsEnabled="False"/>
    </StackPanel>

    <!-- Search bar -->
    <DockPanel DockPanel.Dock="Top" Margin="5">
      <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <TextBox x:Name="SearchBox" 
               Watermark="Type filename to search..." 
               Margin="0,0,5,0"/>
      <Button x:Name="ClearSearchBtn" Content="Clear" Width="50"/>
    </DockPanel>

    <TextBlock x:Name="StatusBar"
               DockPanel.Dock="Bottom"
               Margin="5"
               Text="Ready"/>

    <DataGrid x:Name="FileList"
              AutoGenerateColumns="False"
              CanUserSortColumns="True"
              Margin="5">
      <DataGrid.Columns>
        <DataGridTextColumn Header="File Path"
                            Binding="{Binding}"
                            Width="*" />
      </DataGrid.Columns>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Open File" Click="OnOpenFile"/>
          <MenuItem Header="Delete File" Click="OnDeleteFile"/>
          <MenuItem Header="Rename..." Click="OnRenameFile"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
    </DataGrid>
  </DockPanel>
</Window>